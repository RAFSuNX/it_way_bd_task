{
  "android": {
    "enabled": true,
    "buildType": "release",
    "outputFormat": ["apk", "aab"]
  },
  "ios": {
    "enabled": true,
    "buildType": "release",
    "codesign": false
  },
  "flutter": {
    "version": "3.35.1",
    "channel": "stable"
  },
  "java": {
    "version": "17",
    "distribution": "zulu"
  },
  "xcode": {
    "version": "latest-stable"
  },
  "testing": {
    "runTests": false,
    "testTimeout": "10m"
  },
  "workflow": {
    "sequential": true,
    "artifactRetentionDays": 30
  }
}
